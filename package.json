{
  "name": "cupex",
  "version": "0.4.0",
  "description": "Cupex: widget de consumo de Codex para Windows",
  "author": "Usuario",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "test": "node --test",
    "verify:ui": "electron scripts/verificar-electron.cjs --verificar",
    "verify:features": "electron scripts/verificar-mejoras.cjs --verificar"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.cupex.widget",
    "productName": "Cupex",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icono.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Instalar-Cupex-${version}.exe",
      "deleteAppDataOnUninstall": false
    }
  }
}
